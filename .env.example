# Gmail — John (primary)
GMAIL_CLIENT_ID_PRIMARY=
GMAIL_CLIENT_SECRET_PRIMARY=
GMAIL_REFRESH_TOKEN_PRIMARY=

# Gmail — Christy
GMAIL_CLIENT_ID_CHRISTY=
GMAIL_CLIENT_SECRET_CHRISTY=
GMAIL_REFRESH_TOKEN_CHRISTY=

# Gmail — ebot (feedback inbox - strictly for John's corrections)
GMAIL_CLIENT_ID_EBOT=
GMAIL_CLIENT_SECRET_EBOT=
GMAIL_REFRESH_TOKEN_EBOT=

JOHN_EMAIL=john@libertygroupfunding.com
EBOT_EMAIL=ebot@libertygroupfunding.com
CHRISTINA_EMAIL=cgarboza@libertygroupfunding.com

# Anthropic
ANTHROPIC_API_KEY=

# Notion
NOTION_TOKEN=
NOTION_LOANS_DB_ID=
NOTION_CONDITIONS_DB_ID=

# Arive webhook auth (optional)
ZAPIER_STATIC_HEADER_KEY=

# Gmail scan settings
GMAIL_PROCESSED_LABEL=mortgage-bot-processed
GMAIL_PRESERVE_UNREAD=true
GMAIL_MAX_MESSAGES_PER_INBOX=25
GMAIL_MAX_TOTAL_PER_INBOX_PER_SCAN=50
GMAIL_SCAN_SYNC=true
GMAIL_SCAN_TIMEZONE=America/New_York
APPROVAL_PDF_ONLY=true
# Set true while Christy is OOO and mail forwards to John
GMAIL_SKIP_CHRISTY=false
# Retries for transient OAuth/network errors on Render (default 4)
GMAIL_AUTH_RETRIES=4

# Digest schedule
DIGEST_HOURS=8,12,16

# Internal team status-request auto-drafting (Gil/Adi/Yaeli asking Christy
# "what's the status on X loan" -> drafts a plain-English outstanding-items
# reply pulled from Notion, left as a Gmail draft for review, never auto-sent).
# Set to false to disable without a redeploy.
STATUS_REQUEST_ENABLED=true
# LOs on the @libertygroupfunding.com domain (e.g. Gil) are covered automatically.
# LOs using a personal email address must be listed here explicitly, comma-separated:
STATUS_REQUEST_ALLOWED_SENDERS=adigalrealtor@gmail.com,ysisson@aol.com

DRY_RUN=false

# --- TRID / rate-lock deadline tracking (added 2026-07-28, off until configured) ---
# Add these as Date-type properties in the Notion Loans DB first. Override the
# names below only if you name them differently than the defaults in
# lib/notion-schema.js (Application Date / LE Due Date / LE Delivered Date /
# Closing Date / CD Due Date / Rate Lock Expiration).
# NOTION_APPLICATION_DATE_PROPERTY=
# NOTION_LE_DUE_DATE_PROPERTY=
# NOTION_LE_DELIVERED_DATE_PROPERTY=
# NOTION_CLOSING_DATE_PROPERTY=
# NOTION_CD_DUE_DATE_PROPERTY=
# NOTION_RATE_LOCK_EXPIRATION_PROPERTY=
